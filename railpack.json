{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "go": "1.26.2",
    "node": "24",
    "pnpm": "11"
  },
  "steps": {
    "build": {
      "commands": [
        "cd web && pnpm install --frozen-lockfile && pnpm build",
        "go build -tags embedui -ldflags=-s -o out ./cmd/maitake"
      ]
    }
  },
  "deploy": {
    "startCommand": "./out",
    "variables": {
      "MAITAKE_HOST": "0.0.0.0",
      "MAITAKE_DATA_DIR": "/data"
    }
  }
}
